    <link rel="icon" type="image/svg+xml" href="/astro-portfolio/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />

    <h1>{pageTitle}</h1>
    <p>Voici où je vais publier mon parcours d'apprentissage d'Astro.</p>

    <ul>
      <li><a href="/astro-portfolio/posts/post-1/">Article 1</a></li>
      <li><a href="/astro-portfolio/posts/post-2/">Article 2</a></li>
      <li><a href="/astro-portfolio/posts/post-3/">Article 3</a></li>
    </ul>

    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>
